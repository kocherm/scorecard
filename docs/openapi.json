  "info": {
    "description": "Read the company scorecard and write weekly numbers into it.\n\n**Authentication.** Send an API token as `Authorization: Bearer sc_...`.\nTokens are created on Admin > API tokens and shown once. Scopes: `read`\n(GET only), `write` and `read_write` (GET and writes), `admin` (everything,\nincluding archiving).\n\n**Weeks.** A week is identified by its Monday, `YYYY-MM-DD`, in the business\ntimezone. Writes default to the last closed week, the one that is due. Future\nweeks and weeks before a metric started are refused.\n\n**Writes replace.** Writing a week sets its value, replacing any previous\nvalue, including one typed by hand. Re-sending is safe. Every write is\nrecorded in the audit trail against the token.\n\nFull reference with examples: `docs/API.md` in the repository.\n",
    "title": "Scorecard API",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/ceo": {
      "get": {
        "description": "The seven CEO tiles, the metric filling each, and the categories of tiles that are broken down. Use it to find the names a breakdown call accepts. Any token scope.",
        "operationId": "ceo_slots_api_v1_ceo_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CeoOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing or invalid token"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List CEO tiles and categories",
        "tags": [
          "CEO metrics"
        ]
      }
    },
    "/api/v1/ceo/{slot}/breakdown": {
      "post": {
        "description": "Writes one week of a tile's categories in a single call, and optionally its total. All-or-nothing: every category name is checked first, and an unknown name writes nothing and returns the valid names. Names are never created. `slot` is revenue, expenses or leads. Needs a write, read_write or admin token.",
        "operationId": "write_breakdown_api_v1_ceo__slot__breakdown_post",
        "parameters": [
          {
            "description": "The tile: revenue, expenses or leads",
            "in": "path",
            "name": "slot",
            "required": true,
            "schema": {
              "description": "The tile: revenue, expenses or leads",
              "examples": [
                "expenses"
              ],
              "title": "Slot",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BreakdownIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BreakdownOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing or invalid token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Token scope too low"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Conflict with current configuration"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid input (see detail)"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
